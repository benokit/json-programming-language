{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LambdaJSON Program",
  "$ref": "#/$defs/Value",

  "$defs": {
    "Value": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "$ref": "#/$defs/ArrayValue" },
        { "$ref": "#/$defs/PlainObject" },
        { "$ref": "#/$defs/Literal" },
        { "$ref": "#/$defs/CallNode" }
      ]
    },

    "InputRef": {
      "type": "string",
      "description": "Reference to the input: '#', '#.name', '#0.name'",
      "pattern": "^#"
    },

    "LocalRef": {
      "type": "string",
      "description": "Reference to a name bound by $let or by a lambda's 'as': '@user', '@user.name'",
      "pattern": "^@"
    },

    "ArrayValue": {
      "type": "array",
      "items": { "$ref": "#/$defs/Value" }
    },

    "PlainObject": {
      "type": "object",
      "description": "Data: no key starts with '$'. Evaluated key by key; a key '\\$k' produces '$k'.",
      "propertyNames": { "not": { "pattern": "^\\$" } },
      "additionalProperties": { "$ref": "#/$defs/Value" }
    },

    "Literal": {
      "type": "object",
      "description": "Evaluates to its value as-is",
      "properties": { "$literal": true },
      "required": ["$literal"],
      "additionalProperties": false
    },

    "CallNode": {
      "type": "object",
      "description": "A call: exactly one key starting with '$' naming a primitive or a function declared in an enclosing $let, optionally beside '$let'. No other keys.",
      "propertyNames": { "pattern": "^\\$" },
      "minProperties": 1,
      "maxProperties": 2,
      "not": { "required": ["$literal"] },
      "properties": {
        "$let": {
          "type": "object",
          "description": "Local bindings read as '@name'; a key starting with '$' declares a function",
          "additionalProperties": { "$ref": "#/$defs/Value" }
        }
      },
      "additionalProperties": { "$ref": "#/$defs/Value" },
      "if": { "required": ["$let"] },
      "then": { "minProperties": 2 },
      "else": { "maxProperties": 1 }
    }
  }
}
